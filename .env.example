# Copy this file to .env. Never commit the resulting .env file.
COMPOSE_PROJECT_NAME=coffie-bot

# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
SESSION_TOKEN_PEPPER=replace-with-random-session-pepper-at-least-48-characters-long
SESSION_TTL_SECONDS=900
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL. Keep DATABASE_URL in sync with POSTGRES_PASSWORD for host-side development.
# URL-encode special characters when the password is embedded in the URL.
POSTGRES_DB=coffie
POSTGRES_USER=coffie
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://coffie:replace-with-a-long-random-password@localhost:5432/coffie

# Telegram
BOT_TOKEN=replace-with-token-from-botfather
TELEGRAM_BOT_USERNAME=replace_me_bot
TELEGRAM_WEBAPP_URL=http://localhost:5173
TELEGRAM_INIT_DATA_TTL_SECONDS=600

# Development-only browser authentication. Production must keep this disabled.
DEV_AUTH_ENABLED=true
DEV_AUTH_TELEGRAM_ID=1000000000000

# Paths used outside containers; Compose overrides them with /app paths.
MEDIA_ROOT=./media
SEED_FILE=./configs/demo-seed.json

# Published development ports
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_DEMO_DATA=false

# Production loopback port for a host-level TLS reverse proxy
PROD_FRONTEND_BIND_ADDRESS=127.0.0.1
PROD_FRONTEND_PORT=8080

# Image and persistent-volume names. Use unique names per installation.
BACKEND_IMAGE=coffie-bot-backend:local
FRONTEND_IMAGE=coffie-bot-frontend:local
POSTGRES_VOLUME_NAME=coffie-bot-postgres
MEDIA_VOLUME_NAME=coffie-bot-media
FRONTEND_NODE_MODULES_VOLUME_NAME=coffie-bot-frontend-node-modules
BACKUP_HELPER_IMAGE=postgres:17-alpine
